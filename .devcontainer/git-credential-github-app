#!/bin/sh
# git's credential helper for https://github.com in the dev container.
# The Dockerfile names this file in the environment's config scope, which git reads last, after an
# empty helper that drops every helper any config file named before it, so git authenticates to
# github.com as the agents' GitHub App and as nobody else. It hands git's action and attributes to
# scripts/github-app-token.mjs, whose header says what it answers.
#
# The failure it exists to prevent. No incident yet: it came with the container that acts as the
# App. Were it wrong, git would get no credential for github.com, and a push or a
# tracker pull would ask for a user name in a session with nobody to answer; or the helper would run
# from whatever directory git runs in, where mise's `node` shim has no version unless a `mise.toml`
# sits above it. So it runs the helper from the clone.
#
# Invocation: git runs it as `git-credential-github-app <get|store|erase>`, the attributes on
# stdin. GITHUB_APP_WORKSPACE names the clone, which .devcontainer/devcontainer.json sets.
#
# Needs: the clone, Node through mise, and what the helper needs, the App's key and GitHub's API.
set -eu
: "${GITHUB_APP_WORKSPACE:?is not set: .devcontainer/devcontainer.json sets it to the clone whose scripts/github-app-token.mjs mints the token}"
cd "$GITHUB_APP_WORKSPACE"
exec node scripts/github-app-token.mjs git-credential "$@"
